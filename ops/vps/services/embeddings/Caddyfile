# The gate of the shared embeddings server of a managed VPS (ops/vps/services/embeddings, `starci vps service up <id> --service embeddings`),
# the only way in from the network {{network}} the opted-in app services join. The host's gate (ops/host/stack/embeddings.Caddyfile) with
# its upstream moved from the host's Ollama to the `model` service of this stack. It serves three routes and nothing else:
#   POST /v1/embeddings   the OpenAI-compatible embeddings call
#   POST /api/embed       Ollama's own embeddings call
#   GET  /v1/models       the models list
# A served route without `Authorization: Bearer <key>` answers 401; every other method or path answers 404, with or without the
# key. A request body over 1 MB is refused 413. At most 4 requests reach Ollama at once; the rest wait in Caddy. The key is the
# Swarm secret {{key.file}}, read into Caddy's environment by the entrypoint only ({$EMBEDDINGS_API_KEY} is read when this file
# is loaded), and removed from the request before it reaches Ollama, with the Origin header; the Host is rewritten to the
# loopback name Ollama accepts.
{
	admin off
	auto_https off
}

(ollama) {
	reverse_proxy {{stack}}_model:11434 {
		header_up Host localhost:11434
		header_up -Authorization
		header_up -Origin
		transport http {
			max_conns_per_host 4
			response_header_timeout 120s
		}
	}
}

:8080 {
	request_body {
		max_size 1MB
	}

	@anonymous not header Authorization "Bearer {$EMBEDDINGS_API_KEY}"

	@embed {
		method POST
		path /v1/embeddings /api/embed
	}
	@models {
		method GET
		path /v1/models
	}

	handle @embed {
		respond @anonymous "Unauthorized" 401
		import ollama
	}
	handle @models {
		respond @anonymous "Unauthorized" 401
		import ollama
	}
	handle {
		respond "Not Found" 404
	}
}

# The container's own health probe; never on the shared network's served port.
:8081 {
	respond /healthz "ok" 200
}
