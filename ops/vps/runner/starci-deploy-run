#!/bin/bash
# starci-deploy-run - the root half of the CI deploy runner of a managed server. Only starci-deploy-gate calls it, through the one sudo rule of
# `starci-runner` (/etc/sudoers.d/90-starci-runner); it checks its arguments again itself, since a sudo rule is not a parser.
#   starci-deploy-run <app> <env> <tag>
# Steps, one deploy at a time on the whole server (flock /run/starci-runner.lock, shared by every app on the box):
#   1. fetch the release tag over HTTPS (REPO_URL) with the CI job's own token from stdin into /var/lib/starci-runner/<app>/src and check out
#      the ANNOTATED tag; the tag must equal v<package.json version> (the server holds no repository key: deploy keys may be off for the org);
#   2. npm ci --ignore-scripts with the pinned Node (/opt/starci-node/bin);
#   3. read the image digests of the tag's commit from the registry with the credentials on stdin (two lines, user and token: the CI job's
#      own short-lived GITHUB_TOKEN with packages: read, which dies with the job), or, when stdin is empty, /etc/starci-runner/<app>/registry_token:
#      <prefix><app>:sha-<sha><suffix> per service, waiting up to IMAGE_WAIT_SECONDS for CI to push them;
#   4. `starci app stack deploy --env <env> --image ... --sha <sha> --execute` with SOPS_AGE_KEY_FILE=/root/.config/sops/age/keys.txt: the
#      server's own age key opens the sealed members here and never leaves the box; the deploy reaches the manager through the app's own sealed
#      transport, exactly as from an owner machine.
# Every run appends to /var/log/starci-runner/<app>.log (the deploy's own report; no secret is printed by the deploy) and its verdict to
# /var/log/starci-runner/runs.log. Exit status is the deploy's.
set -euo pipefail
umask 077
app=${1:-} env=${2:-} tag=${3:-}
die() { echo "starci-deploy-run: $1" >&2; exit "${2:-2}"; }
[ "$(id -u)" -eq 0 ] || die "must run as root (through starci-deploy-gate)"
case "$app" in ''|-*|*[!a-z0-9-]*) die "app" ;; esac
grep -qx -- "$app" /etc/starci-runner/apps || die "app not listed"
case "$env" in staging|production) ;; *) die "env" ;; esac
printf '%s\n' "$tag" | grep -Eqx 'v[0-9]{1,4}\.[0-9]{1,4}\.[0-9]{1,6}' || die "tag"

conf=/etc/starci-runner/$app.conf
[ -r "$conf" ] || die "no $conf"
REPO_URL='' IMAGE_PREFIX='' SERVICES_staging='' SERVICES_production='' IMAGE_WAIT_SECONDS=3600 NODE_HOME=/opt/starci-node
# shellcheck disable=SC1090 # root-owned config, mode 600, written by install.sh
. "$conf"
case "$IMAGE_PREFIX" in ghcr.io/*) ;; *) die "IMAGE_PREFIX must be a ghcr.io prefix" ;; esac
eval "services=\${SERVICES_$env}"
[ -n "$services" ] || die "no SERVICES_$env in $conf"
case "$REPO_URL" in https://github.com/*.git) ;; *) die "REPO_URL must be https://github.com/<owner>/<repo>.git" ;; esac
token=/etc/starci-runner/$app/registry_token
# the CI job's credentials on stdin (user, token: its own GITHUB_TOKEN with contents: read and packages: read, dead when the job ends), else the
# server's fallback file; held in memory and in the environment of this root process only, never in an argument (/proc/<pid>/cmdline is world-readable)
reg_user='' reg_token=''
if [ ! -t 0 ]; then IFS= read -r reg_user || true; IFS= read -r reg_token || true; fi
if [ -z "$reg_token" ] && [ -r "$token" ]; then reg_user=$(sed -n 1p "$token"); reg_token=$(sed -n 2p "$token"); fi
[ -n "$reg_user" ] && [ -n "$reg_token" ] || die "no credentials (stdin or $token)"

work=/var/lib/starci-runner/$app
log=/var/log/starci-runner/$app.log
mkdir -p "$work" /var/log/starci-runner
exec 9>/run/starci-runner.lock
if ! flock -w 1800 9; then die "another deploy holds the server for 30 min" 75; fi
stamp() { date -u +%Y-%m-%dT%H:%M:%SZ; }
verdict() { printf '%s app=%s env=%s tag=%s sha=%s exit=%s\n' "$(stamp)" "$app" "$env" "$tag" "${sha:-?}" "$1" >> /var/log/starci-runner/runs.log; }
trap 'verdict $?' EXIT
exec > >(tee -a "$log") 2>&1
  echo "== $(stamp) deploy $app $env $tag"
  export PATH="$NODE_HOME/bin:/usr/local/bin:/usr/bin:/bin"
  export HOME="$work/home" XDG_DATA_HOME="$work/data" npm_config_cache="$work/npm-cache"
  mkdir -p "$HOME/.ssh" "$XDG_DATA_HOME"
  src=$work/src
  # the token rides in an HTTP header set through git's environment config (never a URL, never an argument, never written to .git/config)
  basic=$(printf 'x-access-token:%s' "$reg_token" | base64 -w0)
  if [ ! -d "$src/.git" ]; then git init --quiet "$src"; git -C "$src" remote add origin "$REPO_URL"; fi
  GIT_TERMINAL_PROMPT=0 GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0=http.https://github.com/.extraheader GIT_CONFIG_VALUE_0="AUTHORIZATION: basic $basic" \
    GIT_CONFIG_KEY_1=credential.helper GIT_CONFIG_VALUE_1='' \
    git -C "$src" fetch --quiet --force --no-tags origin "+refs/tags/$tag:refs/tags/$tag"
  unset basic
  [ "$(git -C "$src" cat-file -t "refs/tags/$tag")" = tag ] || die "$tag is not an annotated tag"
  git -C "$src" -c advice.detachedHead=false checkout --quiet --force "refs/tags/$tag^{commit}"
  git -C "$src" clean -qfdx -e node_modules
  sha=$(git -C "$src" rev-parse HEAD)
  version=$(node -p "require('$src/package.json').version")
  [ "v$version" = "$tag" ] || die "the tag $tag is not the package version v$version"
  echo "commit $sha"
  ( cd "$src" && npm ci --ignore-scripts --no-audit --no-fund --loglevel=error )

  export DOCKER_CONFIG="$work/docker"
  mkdir -p "$DOCKER_CONFIG"
  printf '%s\n' "$reg_token" | docker login ghcr.io -u "$reg_user" --password-stdin > /dev/null; unset reg_token
  images=''
  for entry in $services; do
    service=${entry%%=*} rest=${entry#*=}
    name=${rest%%:*} suffix=''
    case "$rest" in *:*) suffix=${rest#*:} ;; esac
    ref="$IMAGE_PREFIX$name:sha-$sha$suffix"
    waited=0
    until digest=$(docker buildx imagetools inspect "$ref" --format '{{json .Manifest}}' 2>/dev/null | node -e 'let b="";process.stdin.on("data",c=>b+=c).on("end",()=>{const d=JSON.parse(b||"{}").digest;if(!/^sha256:[0-9a-f]{64}$/.test(d||""))process.exit(1);process.stdout.write(d)})'); do
      [ "$waited" -lt "$IMAGE_WAIT_SECONDS" ] || die "no image $ref after ${IMAGE_WAIT_SECONDS}s" 3
      sleep 30; waited=$((waited + 30))
    done
    images="$images --image $service=$IMAGE_PREFIX$name@$digest"
    echo "image $service $IMAGE_PREFIX$name@$digest"
  done

  export SOPS_AGE_KEY_FILE=/root/.config/sops/age/keys.txt
  cd "$src"
  # shellcheck disable=SC2086 # $images is a list of --image service=ref words built above from the closed alphabets
  rc=0; node node_modules/starci-harness/dist/main.js app stack deploy --env "$env" $images --sha "$sha" --execute < /dev/null || rc=$?
  docker logout ghcr.io > /dev/null 2>&1 || true
  rm -rf "$DOCKER_CONFIG"
  exit "$rc"
