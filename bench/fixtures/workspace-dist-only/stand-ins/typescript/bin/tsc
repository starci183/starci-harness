// The tsc stand-in: TS2307 for every file under its tsconfig folder importing "@bench/ui" while the package's dist is not built.
const { existsSync, readFileSync, readdirSync, statSync } = require("node:fs")
const { join } = require("node:path")
if (!existsSync(join(process.cwd(), "tsconfig.json"))) {
    console.log("tsc: no tsconfig.json in " + process.cwd())
    process.exit(2)
}
const built = existsSync(join(__dirname, "..", "..", "..", "packages", "ui", "dist", "index.d.ts"))
const walk = (dir) => readdirSync(dir).flatMap((name) => {
    const path = join(dir, name)
    return statSync(path).isDirectory() ? (name === "node_modules" || name === "dist" ? [] : walk(path)) : [path]
})
const bad = walk(process.cwd()).filter((file) => file.endsWith(".ts") && !built && readFileSync(file, "utf8").includes('from "@bench/ui"'))
for (const file of bad) console.log(file + ": error TS2307: Cannot find module '@bench/ui' or its corresponding type declarations.")
process.exit(bad.length === 0 ? 0 : 2)
