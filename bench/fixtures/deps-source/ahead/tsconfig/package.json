{
  "name": "@starci/tsconfig",
  "version": "2.1.0",
  "description": "The StarCi TypeScript configs: base, be (back end), build (back-end emit overlay), next (front-end app), e2e, and package-esm/package-cjs (a package built from src/ to dist/). Strict, including noImplicitAny.",
  "license": "MIT",
  "author": "starci183",
  "homepage": "https://github.com/starci183/starci-harness/tree/main/packages/tsconfig#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starci183/starci-harness.git",
    "directory": "packages/tsconfig"
  },
  "bugs": {
    "url": "https://github.com/starci183/starci-harness/issues"
  },
  "private": false,
  "type": "module",
  "exports": {
    "./base.json": "./base.json",
    "./be.json": "./be.json",
    "./build.json": "./build.json",
    "./next.json": "./next.json",
    "./e2e.json": "./e2e.json",
    "./package-esm.json": "./package-esm.json",
    "./package-cjs.json": "./package-cjs.json"
  },
  "files": [
    "LICENSE",
    "base.json",
    "be.json",
    "build.json",
    "next.json",
    "e2e.json",
    "package-esm.json",
    "package-cjs.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && node --test \"*.spec.ts\""
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
