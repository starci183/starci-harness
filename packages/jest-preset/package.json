{
  "name": "@starci/jest-preset",
  "version": "2.5.0",
  "description": "The StarCi jest config for Nest repositories (unit, integration, e2e and contract projects, ts-jest with diagnostics off, per-file 100 coverage of *.service.ts only) and the one shared unit-test double kit: typed mock<T>(), mockEntityManager(), fakeTransaction(), fakeQueryBuilder(), queueQueryBuilders(), fakeCache(), fakeLock(), recordingEventBus(), recordingQueueOutbox(), fakeInbox(), FakeClock, fakeIds(), builder() and the Outcome matchers toBeRefused/toSucceedWith.",
  "license": "MIT",
  "author": "starci183",
  "homepage": "https://github.com/starci183/starci-harness/tree/main/packages/jest-preset#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starci183/starci-harness.git",
    "directory": "packages/jest-preset"
  },
  "bugs": {
    "url": "https://github.com/starci183/starci-harness/issues"
  },
  "private": false,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "default": "./dist/mock.js"
    },
    "./clock": {
      "types": "./dist/clock.d.ts",
      "default": "./dist/clock.js"
    },
    "./entity-manager": {
      "types": "./dist/entity-manager.d.ts",
      "default": "./dist/entity-manager.js"
    },
    "./query-builder": {
      "types": "./dist/query-builder.d.ts",
      "default": "./dist/query-builder.js"
    },
    "./ids": {
      "types": "./dist/ids.d.ts",
      "default": "./dist/ids.js"
    },
    "./matchers": {
      "types": "./dist/matchers.d.ts",
      "default": "./dist/matchers.js"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "default": "./dist/cache.js"
    },
    "./lock": {
      "types": "./dist/lock.d.ts",
      "default": "./dist/lock.js"
    },
    "./event-bus": {
      "types": "./dist/event-bus.d.ts",
      "default": "./dist/event-bus.js"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "default": "./dist/queue.js"
    },
    "./inbox": {
      "types": "./dist/inbox.d.ts",
      "default": "./dist/inbox.js"
    },
    "./builders": {
      "types": "./dist/builders.d.ts",
      "default": "./dist/builders.js"
    },
    "./merge": {
      "types": "./dist/merge.d.ts",
      "default": "./dist/merge.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@jest/globals": ">=29",
    "@types/jest": ">=29",
    "jest": ">=29",
    "ts-jest": ">=29",
    "typeorm": ">=0.3"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.build.json && node -e \"const fs = require('node:fs'); for (const f of fs.readdirSync('dist', {recursive: true}).filter((n) => n.endsWith('.d.ts'))) fs.writeFileSync('dist/' + f, fs.readFileSync('dist/' + f, 'utf8').replace(/((?:from |import\\()['\\x22]\\.\\.?\\/[^'\\x22]+)\\.ts(['\\x22])/g, (all, head, quote) => head + '.js' + quote))\" && node -e \"require('node:fs').copyFileSync('assets/unit-metadata.generated.js', 'dist/unit-metadata.generated.js')\"",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && npm run typecheck && node --test \"test/**/*.spec.ts\""
  },
  "peerDependenciesMeta": {
    "typeorm": {
      "optional": true
    },
    "@jest/globals": {
      "optional": true
    }
  },
  "devDependencies": {
    "@starci/tsconfig": "file:../tsconfig",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/istanbul-lib-report": "3.0.3",
    "@types/istanbul-reports": "3.0.4",
    "@types/jest": "29.5.14",
    "@types/node": "24.19.2",
    "jest": "29.7.0",
    "jest-runner": "29.7.0",
    "jest-util": "29.7.0",
    "ts-jest": "29.4.12",
    "tslib": "2.8.1",
    "typeorm": "0.3.27",
    "typescript": "5.9.3"
  }
}
