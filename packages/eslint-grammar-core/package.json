{
  "name": "@starci/eslint-grammar-core",
  "version": "0.15.33",
  "description": "ESLint rules for the core Grammar's component, token and composition contracts.",
  "keywords": [
    "eslint",
    "starci",
    "grammar",
    "core"
  ],
  "type": "module",
  "license": "MIT",
  "author": "starci183",
  "homepage": "https://github.com/starci183/starci-harness/tree/main/packages/eslint-grammar-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starci183/starci-harness.git",
    "directory": "packages/eslint-grammar-core"
  },
  "bugs": {
    "url": "https://github.com/starci183/starci-harness/issues"
  },
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "runtime/**",
    "docs/*.md",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@starci/eslint-canon-fe": "9.5.22",
    "eslint": ">=9",
    "typescript": ">=5.9"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.70.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.build.json && node -e \"const fs = require('node:fs'); for (const f of fs.readdirSync('dist', {recursive: true}).filter((n) => n.endsWith('.d.ts'))) fs.writeFileSync('dist/' + f, fs.readFileSync('dist/' + f, 'utf8').replace(/((?:from |import\\()['\\x22]\\.\\.?\\/[^'\\x22]+)\\.ts(['\\x22])/g, (all, head, quote) => head + '.js' + quote))\"",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run typecheck && node --test \"src/**/*.spec.ts\""
  },
  "devDependencies": {
    "@starci/eslint-canon-fe": "file:../eslint-canon-fe",
    "@starci/tsconfig": "file:../tsconfig",
    "@types/node": "24.19.2",
    "@typescript-eslint/types": "^8.70.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3"
  }
}
