{
  "name": "@starci/eslint-canon-be",
  "version": "3.6.0",
  "description": "The StarCi back-end lint canon: every rule its laws publish, gathered as one flat-config plugin.",
  "type": "module",
  "license": "MIT",
  "author": "starci183",
  "homepage": "https://github.com/starci183/starci-harness/tree/main/packages/eslint-canon-be#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starci183/starci-harness.git",
    "directory": "packages/eslint-canon-be"
  },
  "bugs": {
    "url": "https://github.com/starci183/starci-harness/issues"
  },
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "files": [
    "LICENSE",
    "dist/**",
    "!dist/**/*.spec.*",
    "runtime/**",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "typescript": ">=5.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run typecheck && node --test \"src/**/*.spec.ts\""
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "starci",
    "canon"
  ],
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript-eslint/utils": "^8.70.0",
    "eslint-plugin-sonarjs": "4.2.1",
    "eslint-plugin-unicorn": "65.0.0"
  },
  "devDependencies": {
    "@starci/tsconfig": "file:../tsconfig",
    "@types/node": "24.19.2",
    "eslint": "^9.18.0",
    "typescript": "^6.0.3"
  },
  "types": "./dist/index.d.ts"
}
