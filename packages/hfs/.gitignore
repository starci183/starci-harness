# tsc emits .mjs and .d.mts beside their .mts source (packages/README.md build convention: generated output at
# the same relative path). Specs, fixtures, templates and generated data keep hand-checked .mjs: the un-ignores
# below name where a new tracked .mjs may still appear.
*.mjs
*.d.mts
!*.spec.mjs
!src/fixtures/**
!templates/**
!vendor-types.d.mts
# The vendored yaml bundle and the catalog gen-catalog writes, each with its hand-written types, are tracked as they are.
!runtime/engine/yaml.mjs
!runtime/engine/yaml.d.mts
!runtime/packages/cli/src/catalog.generated.mjs
!runtime/packages/cli/src/catalog.generated.d.mts
