{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@starci/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "allowJs": false,
    "noEmit": true
  },
  "include": [
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "templates",
    "src/fixtures",
    "**/*.d.mts"
  ],
  "files": [
    "migration.d.mts",
    "vendor-types.d.mts"
  ]
}
