// module-registry.mts - the module packages of an app (packages/module-<name>) and the registry package (packages/modules) that lists them.
//
// The registry is managed: its manifests and its three source files are rendered from the module list, by `starci app add|remove module` and by
// `starci app sync` (the same function), so a hand edit is drift. A module package is written once by `add module` and is the product's from then on.
import fs from 'node:fs';
import path from 'node:path';
import { byCodeUnit } from '../report/order.mjs';
import { pascalOf } from './service.mjs';

/** The folder name prefix of a module package. */
export const MODULE_PREFIX = 'module-';
/** The package that lists every module package. */
export const REGISTRY_DIR = 'packages/modules';
/** The product's agent SDK package folder every module builds on. */
export const SDK_DIR = 'packages/agent-sdk';

/** A file of the registry package: its app-relative path and its content. */
export interface RegistryFile {
  readonly path: string;
  readonly content: string;
}

const HEADER = '// Generated by starci app sync (module registry). Do not edit: run "npx starci app sync --execute".';
const json = (value: unknown): string => `${JSON.stringify(value, null, 2)}\n`;
/** `loyalty-points` as the UPPER_SNAKE prefix of the constants a module exports. */
export const upperOf = (name: string): string => name.replace(/-/g, '_').toUpperCase();

/** The module names under `packages/` of the app at `root` (a folder module-<name> holding a package.json), sorted. */
export function moduleNames(root: string): string[] {
  const folder = path.join(root, 'packages');
  if (!fs.existsSync(folder)) return [];
  return fs.readdirSync(folder, { withFileTypes: true })
    .filter((entry) => entry.isDirectory() && entry.name.startsWith(MODULE_PREFIX) && fs.existsSync(path.join(folder, entry.name, 'package.json')))
    .map((entry) => entry.name.slice(MODULE_PREFIX.length))
    .sort(byCodeUnit);
}

/** The exports map of the registry and of a module: the React-free halves and, for a module, its Grammar workbench. */
const registryExports = (): Record<string, unknown> => ({
  '.': { types: './dist/index.d.ts', default: './dist/index.js' },
  './template': { types: './dist/template/index.d.ts', default: './dist/template/index.js' },
  './manifest': { types: './dist/manifest/index.d.ts', default: './dist/manifest/index.js' },
});

/** The files of the registry package for `names` (empty when no module exists: the package is then absent). */
export function registryFiles(project: string, names: readonly string[]): RegistryFile[] {
  if (names.length === 0) return [];
  const sorted = [...names].sort(byCodeUnit);
  const sdk = `@${project}/agent-sdk`;
  const module = (name: string): string => `@${project}/${MODULE_PREFIX}${name}`;
  const serverImports = sorted.map((name) => `import { ${upperOf(name)}_SERVER } from "${module(name)}/template"`).join('\n');
  const workbenchImports = sorted.map((name) => `import { ${upperOf(name)}_WORKBENCH } from "${module(name)}/manifest"`).join('\n');
  const dependencies = Object.fromEntries([[sdk, '*'], ...sorted.map((name) => [module(name), '*'])].sort(([a], [b]) => byCodeUnit(a as string, b as string)));
  return [
    {
      path: `${REGISTRY_DIR}/package.json`,
      content: json({
        name: `@${project}/modules`,
        version: '0.0.0',
        private: true,
        description: 'The one list of the product modules built on the agent SDK, all React-free: ./template (every module\'s server half, for the back end) and ./manifest (every workbench declaration and the spec registry they assemble).',
        exports: registryExports(),
        scripts: { build: 'tsc -p tsconfig.build.json', typecheck: 'tsc --noEmit --pretty false' },
        dependencies,
      }),
    },
    {
      path: `${REGISTRY_DIR}/tsconfig.json`,
      content: json({ extends: '@starci/tsconfig/next.json', compilerOptions: { incremental: false, types: [] }, include: ['src/**/*.ts'], exclude: ['node_modules', 'dist'] }),
    },
    {
      path: `${REGISTRY_DIR}/tsconfig.build.json`,
      content: json({
        extends: './tsconfig.json',
        compilerOptions: { rootDir: 'src', outDir: 'dist', noEmit: false, declaration: true, module: 'node16', moduleResolution: 'node16' },
      }),
    },
    {
      path: `${REGISTRY_DIR}/src/index.ts`,
      content: `${HEADER}\nimport { MODULE_SERVERS } from "./template"\n\n/** The keys of every module this registry lists, for a host that checks its own wiring against it. */\nexport const REGISTERED_MODULE_KEYS: ReadonlyArray<string> = MODULE_SERVERS.map((module) => module.key)\n`,
    },
    {
      path: `${REGISTRY_DIR}/src/template/index.ts`,
      content: `${HEADER}\nimport type { ModuleServer } from "${sdk}/module"\n${serverImports}\n\n/** The server half of every module built on the SDK; the back end reads nothing else of a module. */\nexport const MODULE_SERVERS: ReadonlyArray<ModuleServer> = [${sorted.map((name) => `${upperOf(name)}_SERVER`).join(', ')}]\n`,
    },
    {
      path: `${REGISTRY_DIR}/src/manifest/index.ts`,
      content: `${HEADER}\nimport { specRegistryFrom } from "${sdk}/workbench/contract"\nimport type { WorkbenchDeclaration, WorkbenchSpecRegistry } from "${sdk}/workbench/contract"\n${workbenchImports}\n\n/** The workbench declaration of every module built on the SDK; the front end pairs each with how it draws. */\nexport const MODULE_WORKBENCHES: ReadonlyArray<WorkbenchDeclaration> = [${sorted.map((name) => `${upperOf(name)}_WORKBENCH`).join(', ')}]\n\n/** Everything a stored spec may name: the SDK's blocks and each module's exposed blocks, reads and actions. */\nexport const SPEC_REGISTRY: WorkbenchSpecRegistry = specRegistryFrom(MODULE_WORKBENCHES)\n`,
    },
  ];
}

/** The PascalCase label of a module, for the messages that name it. */
export const labelOf = (name: string): string => pascalOf(name);
