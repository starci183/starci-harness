import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { declarationSurface, isEmittableSource, type SurfaceProblem } from '../runtime/scripts/lib/declaration-surface.mjs';
import { loadTypescript } from '../runtime/scripts/lib/package-at.mjs';
import { formatted, prettierOf } from './app-prettier.mjs';
import { applyEdits, importEdits, type Edit } from './explicit-surface-edit.mjs';
import { conventionType, MAX_TYPE_LENGTH, renderType, type ImportNeed } from './explicit-surface-render.mjs';
import type { NamingContext } from './explicit-surface-names.mjs';
import { GENERATED, relativePosix, sideFolders } from './source-tree.mjs';
import type * as TsTypes from 'typescript';

/** The TypeScript compiler API of the app's own install (loadTypescript), typed by the version this package develops against. */
type Ts = typeof import('typescript');

/** One annotation written: the type of an export that was inferred. */
export interface ExplicitSurfaceChange { file: string; line: number; column: number; code: string; name: string; from: string; to: string }
/** One export left for a person, with why and what to do. */
export interface ExplicitSurfaceFinding { file: string; line: number; column: number; code: string; name: string; annotate: string; reason: string; suggestion: string }
/** The report of a migration (`starci app codemod explicit-surface`). */
export interface ExplicitSurfaceReport {
  schema: string; root: string; write: boolean; maxTypeLength: number; filesScanned: number; filesOpen: number; filesChanged: string[]; filesStillOpen: number;
  formatted: boolean; changes: ExplicitSurfaceChange[]; findings: ExplicitSurfaceFinding[];
}

const PACKAGE_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const posix = (file: string): string => file.replaceAll('\\', '/');
/** A file a generator wrote: it is regenerated, never edited. */
const GENERATED_HEADER = /@generated|do not edit|auto-generated|autogenerated/i;

/** What to do about an export the classifier reports and the codemod does not edit, by what the classifier says to annotate. */
const SUGGESTIONS: Readonly<Record<string, string>> = {
  'destructured export': 'export each name as its own variable with a type: `export const name: Type = source.name`',
  'accessor type': 'write the accessor type: `get name(): Type`',
  'property type': 'write the property type: `name: Type = ...`',
  'exported value': 'declare a named type, export it and annotate the export: `export default value satisfies Type` or `export const name: Type = ...`',
};

/** The export an isolated-declaration diagnostic points at, and which annotation it needs. */
type Target =
  | { kind: 'return'; node: TsTypes.FunctionDeclaration | TsTypes.MethodDeclaration | TsTypes.ArrowFunction | TsTypes.FunctionExpression }
  | { kind: 'variable'; node: TsTypes.VariableDeclaration }
  | { kind: 'parameter'; node: TsTypes.ParameterDeclaration }
  | { kind: 'property'; node: TsTypes.PropertyDeclaration };

/** The innermost node of `source` that contains `start`. */
function innermostAt(ts: Ts, source: TsTypes.SourceFile, start: number): TsTypes.Node {
  let found: TsTypes.Node = source;
  const descend = (node: TsTypes.Node): void => {
    if (start < node.getStart(source) || start >= node.end) return;
    found = node;
    ts.forEachChild(node, descend);
  };
  ts.forEachChild(source, descend);
  return found;
}

/** The declaration a diagnostic of the isolated declaration emit sits in, or undefined when the codemod has no annotation for it. */
function locate(ts: Ts, source: TsTypes.SourceFile, problem: SurfaceProblem): Target | undefined {
  for (let node: TsTypes.Node | undefined = innermostAt(ts, source, problem.start); node !== undefined && node !== source; node = node.parent) {
    const named = (ts.isFunctionDeclaration(node) || ts.isMethodDeclaration(node)) && node.name !== undefined && node.name.getStart(source) === problem.start;
    if ((problem.code === 9007 || problem.code === 9008) && (named || ((ts.isArrowFunction(node) || ts.isFunctionExpression(node)) && node.getStart(source) === problem.start))) {
      return { kind: 'return', node: node as Extract<Target, { kind: 'return' }>['node'] };
    }
    if (problem.code === 9010 && ts.isVariableDeclaration(node) && node.name.getStart(source) === problem.start) return { kind: 'variable', node };
    if ((problem.code === 9011 || problem.code === 9025) && ts.isParameter(node)) return { kind: 'parameter', node };
    if (problem.code === 9012 && ts.isPropertyDeclaration(node) && node.name.getStart(source) === problem.start) return { kind: 'property', node };
  }
  return problem.annotate === 'exported value' ? declarationOfExpression(ts, source, problem.start) : undefined;
}

/** The function, variable, parameter or property whose type an expression the emit cannot read (an array, an object with a shorthand, a call) stands for. */
function declarationOfExpression(ts: Ts, source: TsTypes.SourceFile, start: number): Target | undefined {
  for (let node: TsTypes.Node = innermostAt(ts, source, start); node !== source; node = node.parent) {
    const { parent } = node;
    if (ts.isReturnStatement(node)) {
      for (let owner: TsTypes.Node = node; owner !== source; owner = owner.parent) {
        if (ts.isFunctionDeclaration(owner) || ts.isMethodDeclaration(owner) || ts.isArrowFunction(owner) || ts.isFunctionExpression(owner)) return { kind: 'return', node: owner };
      }
      return undefined;
    }
    if (ts.isArrowFunction(parent) && parent.body === node) return { kind: 'return', node: parent };
    if (ts.isVariableDeclaration(parent) && parent.initializer === node) return { kind: 'variable', node: parent };
    if (ts.isParameter(parent) && parent.initializer === node) return { kind: 'parameter', node: parent };
    if (ts.isPropertyDeclaration(parent) && parent.initializer === node) return { kind: 'property', node: parent };
  }
  return undefined;
}

/** The edits that write `typeText` on `target`. */
function annotationEdits(ts: Ts, source: TsTypes.SourceFile, target: Target, typeText: string): Edit[] {
  const insert = (at: number, text: string): Edit => ({ start: at, end: at, text });
  if (target.kind === 'variable') return [insert(target.node.exclamationToken?.end ?? target.node.name.end, `: ${typeText}`)];
  if (target.kind === 'parameter') return [insert(target.node.questionToken?.end ?? target.node.name.end, `: ${typeText}`)];
  if (target.kind === 'property') return [insert((target.node.questionToken ?? target.node.exclamationToken)?.end ?? target.node.name.end, `: ${typeText}`)];
  const { node } = target;
  const children = node.getChildren(source);
  const open = children.find(child => child.kind === ts.SyntaxKind.OpenParenToken);
  if (open === undefined) {
    // `x => x` has no parentheses to carry a return type: `(x): T => x`.
    const only = node.parameters[0] as TsTypes.ParameterDeclaration;
    return [insert(only.getStart(source), '('), insert(only.end, `): ${typeText}`)];
  }
  const close = children.find(child => child.kind === ts.SyntaxKind.CloseParenToken && child.pos >= node.parameters.end) as TsTypes.Node;
  return [insert(close.end, `: ${typeText}`)];
}

/** The change kind of a target, as the report names it. */
const CODE: Readonly<Record<Target['kind'], string>> = { return: 'RETURN_TYPE', variable: 'VARIABLE_TYPE', parameter: 'PARAMETER_TYPE', property: 'PROPERTY_TYPE' };

/** What one file becomes: its annotations, the imports they need, and the exports left for a person. */
interface FilePlan { edits: Edit[]; needs: ImportNeed[]; changes: ExplicitSurfaceChange[]; findings: ExplicitSurfaceFinding[] }

/** The type to write for `target`, from the checker, or the reason it is not written. */
function typeFor(c: NamingContext, target: Target, name: string, maxLength: number): ReturnType<typeof renderType> {
  const { checker, ts } = c;
  if (target.kind === 'return') {
    const signature = checker.getSignatureFromDeclaration(target.node);
    if (signature === undefined || target.node.body === undefined) return { ok: false, code: 'NO_SIGNATURE', reason: 'the function has no body to infer from', suggestion: 'write the return type by hand' };
    if (checker.getTypePredicateOfSignature(signature) !== undefined) return { ok: false, code: 'TYPE_PREDICATE', reason: 'the return type is an inferred type predicate, which `boolean` would erase', suggestion: 'write the predicate: `value is Type`' };
    const inferred = checker.getReturnTypeOfSignature(signature);
    return conventionType(c, name, inferred, target.node, 'function') ?? renderType(c, inferred, target.node, maxLength);
  }
  const node: TsTypes.Node = target.kind === 'parameter' ? target.node : target.node.name;
  if (target.kind === 'parameter' && !ts.isIdentifier(target.node.name)) return { ok: false, code: 'DESTRUCTURED_PARAMETER', reason: 'the parameter is a destructuring pattern', suggestion: 'write the parameter type: `({ a, b }: Props)`' };
  const inferred = checker.getTypeAtLocation(node);
  return (target.kind === 'variable' ? conventionType(c, name, inferred, node, 'variable') : undefined) ?? renderType(c, inferred, node, maxLength);
}

/** Plans the annotations of one open file; every problem it does not annotate becomes a finding. */
function planFile(c: NamingContext, file: string, problems: readonly SurfaceProblem[], maxLength: number): FilePlan {
  const plan: FilePlan = { edits: [], needs: [], changes: [], findings: [] };
  const seen = new Set<string>();
  for (const problem of problems) {
    const place = c.source.getLineAndCharacterOfPosition(problem.start);
    const where = { file, line: place.line + 1, column: place.character + 1, name: problem.name, annotate: problem.annotate };
    const target = locate(c.ts, c.source, problem);
    if (target === undefined) {
      plan.findings.push({ ...where, code: problem.annotate === 'destructured export' ? 'DESTRUCTURED_EXPORT' : 'NOT_ANNOTATED', reason: problem.reason, suggestion: SUGGESTIONS[problem.annotate] ?? 'annotate it by hand' });
      continue;
    }
    const key = `${target.kind}:${target.node.pos}`;
    if (seen.has(key)) continue;
    seen.add(key);
    const rendered = typeFor(c, target, problem.name, maxLength);
    if (!rendered.ok) {
      plan.findings.push({ ...where, code: rendered.code, reason: rendered.reason, suggestion: rendered.suggestion });
      continue;
    }
    plan.edits.push(...annotationEdits(c.ts, c.source, target, rendered.text));
    plan.needs.push(...rendered.needs);
    plan.changes.push({ ...where, code: CODE[target.kind], from: 'inferred', to: rendered.text });
  }
  return plan;
}

/** The diagnostics of a file as a multiset of `code: message`, with positions left out so an edit above them does not count. */
function diagnosticsOf(ts: Ts, program: TsTypes.Program, file: TsTypes.SourceFile): Map<string, number> {
  const counts = new Map<string, number>();
  for (const diagnostic of [...program.getSyntacticDiagnostics(file), ...program.getSemanticDiagnostics(file)]) {
    const key = `${diagnostic.code}: ${ts.flattenDiagnosticMessageText(diagnostic.messageText, '\n')}`;
    counts.set(key, (counts.get(key) ?? 0) + 1);
  }
  return counts;
}

/** The first diagnostic the new text has that the old text did not, or undefined. */
function addedDiagnostic(before: Map<string, number>, after: Map<string, number>): string | undefined {
  for (const [key, count] of after) if (count > (before.get(key) ?? 0)) return key;
  return undefined;
}

/** A TypeScript program for one tsconfig of a side: its options and the files it reads. */
interface Group { options: TsTypes.CompilerOptions; rootNames: string[]; files: string[] }

/** The tsconfig that owns `file`: the nearest `tsconfig.json` from its folder up to `top`, else undefined. */
function owningConfig(file: string, top: string): string | undefined {
  for (let folder = path.dirname(file); folder.length >= top.length; folder = path.dirname(folder)) {
    const candidate = path.join(folder, 'tsconfig.json');
    if (fs.existsSync(candidate)) return candidate;
    if (folder === path.dirname(folder)) break;
  }
  return undefined;
}

/** The options and root files of the tsconfig at `config`, or the inferred ones when there is none. */
function groupOf(ts: Ts, config: string | undefined, files: readonly string[]): Group {
  const parsed = config === undefined ? undefined : ts.getParsedCommandLineOfConfigFile(config, {}, { ...ts.sys, onUnRecoverableConfigFileDiagnostic: () => undefined });
  const options: TsTypes.CompilerOptions = parsed?.options ?? { jsx: ts.JsxEmit.Preserve, target: ts.ScriptTarget.Latest, module: ts.ModuleKind.ESNext, moduleResolution: ts.ModuleResolutionKind.Bundler, strict: true, noEmit: true };
  const known = new Set((parsed?.fileNames ?? []).map(posix));
  return { options: { ...options, noEmit: true }, rootNames: [...known, ...files.map(posix).filter(file => !known.has(file))], files: [...files] };
}

/** The source file the program holds for `file`, found by its forward-slash name, ignoring the case of the drive letter. */
function programFile(program: TsTypes.Program, file: string): TsTypes.SourceFile | undefined {
  const normal = posix(file);
  return program.getSourceFile(normal) ?? program.getSourceFile(normal.replace(/^[a-z]:/, drive => drive.toUpperCase())) ?? program.getSourceFile(normal.replace(/^[A-Z]:/, drive => drive.toLowerCase()));
}

/** A program that reads `texts` in place of the files on disk, reusing the old program's unchanged files. */
function programWith(ts: Ts, group: Group, texts: ReadonlyMap<string, string>, old?: TsTypes.Program): TsTypes.Program {
  const host = ts.createCompilerHost(group.options, true);
  const original = host.getSourceFile.bind(host);
  const wanted = new Map([...texts].map(([file, text]) => [posix(file).toLowerCase(), text]));
  host.getSourceFile = (fileName, languageVersionOrOptions, onError, shouldCreate) => {
    const text = wanted.get(posix(fileName).toLowerCase());
    return text === undefined ? original(fileName, languageVersionOrOptions, onError, shouldCreate) : ts.createSourceFile(fileName, text, languageVersionOrOptions, true);
  };
  return ts.createProgram({ rootNames: group.rootNames, options: group.options, host, ...(old === undefined ? {} : { oldProgram: old }) });
}

/** The files of a side the codemod reads: those the installed lint canon selects, else every TypeScript source outside generated folders. */
async function sideSources(root: string, side: string, folder: string): Promise<{ files: string[]; scope: 'canon' | 'walk' }> {
  let selects: ((relative: string) => boolean) | undefined;
  let ignores: ((relative: string) => boolean) | undefined;
  try {
    const lint = await import('../lint/run.mjs');
    const scope = lint.canonScope(await lint.installedLintConfig({ repoRoot: root, cwd: folder, side }));
    selects = scope.source;
    ignores = (relative): boolean => scope.ignored(relative) || scope.ignored(`${relative}/__starci_scope_probe__`);
  } catch { /* an app without its canon installed is read by walking */ }
  const files: string[] = [];
  const visit = (directory: string): void => {
    for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
      const target = path.join(directory, entry.name);
      const relative = relativePosix(folder, target);
      if (entry.isDirectory()) {
        if (!GENERATED.has(entry.name) && ignores?.(relative) !== true) visit(target);
      } else if (entry.isFile() && isEmittableSource(entry.name) && (selects?.(relative) ?? true) && ignores?.(relative) !== true) files.push(target);
    }
  };
  visit(folder);
  return { files: files.sort(), scope: selects === undefined ? 'walk' : 'canon' };
}

/** One open file read from the program of its group. */
interface OpenFile { absolute: string; relative: string; text: string; problems: SurfaceProblem[] }

/** The side-relative name a report gives `absolute`. */
const nameOf = (root: string, absolute: string): string => relativePosix(root, absolute);

/** Plans every open file of one program, checks that the rewritten files read no worse than the originals, and returns what each file becomes. */
async function migrateGroup({ ts, root, group, open, maxLength, report }: { ts: Ts; root: string; group: Group; open: readonly OpenFile[]; maxLength: number; report: ExplicitSurfaceReport }): Promise<Map<string, string>> {
  let program = programWith(ts, group, new Map());
  const extra = ['react', 'next'].flatMap(name => {
    const resolved = ts.resolveModuleName(name, open[0]?.absolute ?? root, group.options, ts.sys).resolvedModule?.resolvedFileName;
    return resolved === undefined || programFile(program, resolved) !== undefined ? [] : [posix(resolved)];
  });
  if (extra.length) {
    group.rootNames = [...group.rootNames, ...extra];
    program = programWith(ts, group, new Map());
  }
  const checker = program.getTypeChecker();
  const rewritten = new Map<string, string>();
  const planned = new Map<string, FilePlan>();
  for (const file of open) {
    const source = programFile(program, file.absolute);
    if (source === undefined || source.text !== file.text) {
      report.findings.push(...file.problems.map(problem => ({ file: file.relative, line: 1, column: 1, code: 'NOT_IN_PROGRAM', name: problem.name, annotate: problem.annotate, reason: 'the file is not part of the side\'s TypeScript program', suggestion: 'include it in the tsconfig, then run the codemod again' })));
      continue;
    }
    const context: NamingContext = { ts, program, checker, options: group.options, source, file: posix(file.absolute), text: file.text };
    const plan = planFile(context, file.relative, file.problems, maxLength);
    planned.set(file.absolute, plan);
    if (plan.edits.length) rewritten.set(file.absolute, applyEdits(file.text, [...plan.edits, ...importEdits(ts, source, file.text, plan.needs)]));
  }
  for (const [absolute, plan] of planned) if (!rewritten.has(absolute)) report.findings.push(...plan.findings);
  if (!rewritten.size) return rewritten;
  const after = programWith(ts, group, rewritten, program);
  for (const [absolute, text] of [...rewritten]) {
    const plan = planned.get(absolute) as FilePlan;
    const before = programFile(program, absolute) as TsTypes.SourceFile;
    const added = addedDiagnostic(diagnosticsOf(ts, program, before), diagnosticsOf(ts, after, programFile(after, absolute) as TsTypes.SourceFile));
    if (added !== undefined) {
      rewritten.delete(absolute);
      report.findings.push(...plan.changes.map(change => ({ file: change.file, line: change.line, column: change.column, code: 'NOT_SOUND', name: change.name, annotate: change.code, reason: `writing \`${change.to}\` makes the compiler report: ${added}`, suggestion: 'write the type by hand' })), ...plan.findings);
      continue;
    }
    report.changes.push(...plan.changes);
    report.findings.push(...plan.findings);
    const remaining = declarationSurface(ts, absolute, text, group.options.module)?.problems ?? [];
    for (const problem of remaining) {
      if (report.findings.some(found => found.file === nameOf(root, absolute) && found.name === problem.name && found.annotate === problem.annotate)) continue;
      const place = ts.createSourceFile(absolute, text, ts.ScriptTarget.Latest).getLineAndCharacterOfPosition(problem.start);
      report.findings.push({ file: nameOf(root, absolute), line: place.line + 1, column: place.character + 1, code: 'STILL_OPEN', name: problem.name, annotate: problem.annotate, reason: problem.reason, suggestion: SUGGESTIONS[problem.annotate] ?? 'annotate it by hand' });
    }
  }
  return rewritten;
}

/**
 * Preview or apply the explicit type annotations of one app: for every TypeScript source of each side that the declaration classifier counts as open
 * (R368, HFS_EXPLICIT_EXPORT_SURFACE), the types the app's own checker infers are written where they are short, named and sound. Every other export is kept in the report.
 */
export async function migrateExplicitSurface({ root, write = false, ts: given, maxTypeLength = MAX_TYPE_LENGTH }: { root: string; write?: boolean; ts?: Ts | null; maxTypeLength?: number }): Promise<ExplicitSurfaceReport> {
  const folders = sideFolders(root);
  if (!folders.length) throw new Error('explicit-surface runs at an app root with a be/ or fe/ directory');
  const report: ExplicitSurfaceReport = {
    schema: 'starci/explicit-surface-report@1', root, write, maxTypeLength, filesScanned: 0, filesOpen: 0, filesChanged: [], filesStillOpen: 0, formatted: false, changes: [], findings: [],
  };
  const written = new Map<string, string>();
  for (const folder of folders) {
    const ts = given ?? loadTypescript(folder, root, PACKAGE_ROOT);
    if (!ts) throw new Error('explicit-surface needs TypeScript installed in the app or @starci/hfs development checkout');
    if ((ts as { transpileDeclaration?: unknown }).transpileDeclaration === undefined) throw new Error('explicit-surface needs TypeScript 5.5 or later, which writes declarations file by file');
    const { files } = await sideSources(root, path.basename(folder), folder);
    const groups = new Map<string, { config: string | undefined; files: string[] }>();
    for (const absolute of files) {
      const text = fs.readFileSync(absolute, 'utf8');
      report.filesScanned += 1;
      if (GENERATED_HEADER.test(text.slice(0, 400))) continue;
      const config = owningConfig(absolute, root);
      const entry = groups.get(config ?? '') ?? { config, files: [] };
      entry.files.push(absolute);
      groups.set(config ?? '', entry);
    }
    for (const { config, files: members } of groups.values()) {
      const group = groupOf(ts, config, members);
      const open: OpenFile[] = [];
      for (const absolute of members) {
        const text = fs.readFileSync(absolute, 'utf8');
        const surface = declarationSurface(ts, posix(absolute), text, group.options.module);
        if (surface !== null && surface.problems.length) open.push({ absolute, relative: nameOf(root, absolute), text, problems: surface.problems });
      }
      report.filesOpen += open.length;
      if (!open.length) continue;
      for (const [absolute, text] of await migrateGroup({ ts, root, group, open, maxLength: maxTypeLength, report })) written.set(absolute, text);
    }
  }
  const prettier = prettierOf(root, folders);
  report.formatted = prettier !== undefined && written.size > 0;
  for (const [absolute, text] of written) {
    const final = prettier === undefined ? text : await formatted(prettier, root, absolute, text);
    report.filesChanged.push(nameOf(root, absolute));
    if (write) fs.writeFileSync(absolute, final);
  }
  report.filesStillOpen = new Set(report.findings.map(finding => finding.file)).size;
  report.changes.sort((a, b) => (a.file < b.file ? -1 : a.file > b.file ? 1 : a.line - b.line));
  report.findings.sort((a, b) => (a.file < b.file ? -1 : a.file > b.file ? 1 : a.line - b.line));
  report.filesChanged.sort();
  return report;
}

const cell = (value: unknown): string => String(value).replaceAll('|', '\\|').replaceAll('\n', ' ');

/** Render the annotations and what is left for a person as Markdown; JSON consumers read the same report object. */
export function explicitSurfaceMarkdown(report: ExplicitSurfaceReport): string {
  const out = [
    '# explicit-surface', '',
    `Scanned ${report.filesScanned} files, ${report.filesOpen} open, ${report.filesChanged.length} ${report.write ? 'changed' : 'would change'}, ${report.changes.length} annotations, ${report.findings.length} exports in ${report.filesStillOpen} files left for a person.`, '',
  ];
  if (report.findings.length) {
    out.push('## Left for a person', '', '| location | export | code | reason | suggested fix |', '|---|---|---|---|---|');
    for (const finding of report.findings) out.push(`| ${cell(`${finding.file}:${finding.line}:${finding.column}`)} | ${cell(finding.name)} | ${finding.code} | ${cell(finding.reason)} | ${cell(finding.suggestion)} |`);
    out.push('');
  }
  if (report.changes.length) {
    out.push('## Annotations', '', '| location | export | code | type written |', '|---|---|---|---|');
    for (const item of report.changes) out.push(`| ${cell(`${item.file}:${item.line}:${item.column}`)} | ${cell(item.name)} | ${item.code} | \`${cell(item.to)}\` |`);
    out.push('');
  }
  return `${out.join('\n')}\n`;
}
