    "db:image": "docker build --tag {{dbImage}} db",
    "db:create": "npm run db:image && docker create --name {{project}}-dev-db -p 127.0.0.1:54322:5432 -e POSTGRES_HOST_AUTH_METHOD=trust -v {{project}}-dev-db-data:/var/lib/postgresql/data {{dbImage}}",
    "db:start": "docker start {{project}}-dev-db",
    "db:stop": "docker stop {{project}}-dev-db",
    "db:reset": "docker rm -f {{project}}-dev-db && docker volume rm {{project}}-dev-db-data && npm run db:create && npm run db:start",
    "db:new": "{{appBinary}} db new",
    "db:push": "{{appBinary}} db migrate --url-env DATABASE_URL --execute",
    "db:plan": "{{appBinary}} db plan --url-env DATABASE_URL",
    "db:dump": "{{appBinary}} db dump --url-env DATABASE_URL --out ../{{project}}-db-backups",
    "db:lint": "{{appBinary}} check --fast",
