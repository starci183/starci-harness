export const SiteShell = (props: SiteShellProps) => (
    <GrammarRoot>
        <WorkspaceShell
            viewport="flow"
            primaryLabel={props.brand}
            header={
                <TopBar
                    brand={<Link href={props.homeHref}>{props.brand}</Link>}
                    {...(props.fit === undefined ? {} : { fit: props.fit })}
                />
            }
            primary={props.children}
        />
    </GrammarRoot>
)
