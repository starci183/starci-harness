{
  "name": "@starci/auth",
  "version": "0.6.0",
  "description": "The sign-in of a StarCi app in one package, for both editions. Lite: a NestJS module (EdDSA access tokens with a multi-key JWKS, bcrypt passwords, pluggable OAuth sign-in providers with state and PKCE (Google, GitHub), rotating refresh tokens with a reuse grace window and reuse detection, a failures-only sign-in limit, the refresh cookie). Full: the OIDC client of the identity provider (discovery, JWKS with caching and rotation, algorithm-pinned token checks, role mapping, the authorization code flow with PKCE and nonce, Keycloak brokering and admin) and issuer presets (Keycloak, Google ID tokens, GitHub Actions OIDC). The door contracts, the front-end auth clients (lite and OIDC) with React bindings, and test doubles with a fake OIDC issuer.",
  "keywords": [
    "auth",
    "jwt",
    "jwks",
    "eddsa",
    "passport",
    "google-oauth",
    "github-oauth",
    "pkce",
    "refresh-token",
    "oidc",
    "openid-connect",
    "keycloak",
    "github-actions",
    "nestjs",
    "react"
  ],
  "license": "MIT",
  "author": "starci183",
  "homepage": "https://github.com/starci183/starci-harness/tree/main/packages/auth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starci183/starci-harness.git",
    "directory": "packages/auth"
  },
  "bugs": {
    "url": "https://github.com/starci183/starci-harness/issues"
  },
  "private": false,
  "type": "module",
  "main": "./dist/contracts/index.js",
  "types": "./dist/contracts/index.d.ts",
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./oidc": {
      "types": "./dist/oidc/index.d.ts",
      "default": "./dist/oidc/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./client/react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./client/oidc": {
      "types": "./dist/client/oidc/index.d.ts",
      "default": "./dist/client/oidc/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./migrations/*": "./migrations/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "migrations",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.build.json && node -e \"const fs = require('node:fs'); for (const f of fs.readdirSync('dist', {recursive: true}).filter((n) => n.endsWith('.d.ts'))) fs.writeFileSync('dist/' + f, fs.readFileSync('dist/' + f, 'utf8').replace(/((?:from |import\\()['\\x22]\\.\\.?\\/[^'\\x22]+)\\.ts(['\\x22])/g, (all, head, quote) => head + '.js' + quote))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.isolated.json",
    "lint": "eslint .",
    "test": "npm run typecheck && npm run lint && node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"src/**/*.spec.ts\" --test-coverage-lines=90 \"src/**/*.spec.ts\"",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@nestjs/passport": "11.0.5",
    "@starci/common": "1.0.1",
    "bcryptjs": "3.0.3",
    "jose": "6.2.12",
    "passport": "0.7.0",
    "passport-google-oauth20": "2.0.0",
    "passport-local": "1.0.0",
    "passport-oauth2": "1.8.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "react": ">=18",
    "reflect-metadata": "^0.1.12 || ^0.2.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "12.4.2",
    "@nestjs/testing": "11.2.5",
    "@starci/common": "file:../common",
    "@types/express": "4.17.25",
    "@types/node": "22.20.4",
    "@types/passport-google-oauth20": "2.0.17",
    "@types/passport-local": "1.0.38",
    "@types/passport-oauth2": "1.8.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "jiti": "2.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
