{
  "name": "@starci/eslint-canon-fe",
  "version": "9.3.0",
  "description": "Universal front-end lint laws for TypeScript and Next.js, independent of the selected Grammar family.",
  "type": "module",
  "license": "MIT",
  "author": "starci183",
  "homepage": "https://github.com/starci183/starci-harness/tree/main/packages/eslint-canon-fe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starci183/starci-harness.git",
    "directory": "packages/eslint-canon-fe"
  },
  "bugs": {
    "url": "https://github.com/starci183/starci-harness/issues"
  },
  "private": false,
  "exports": {
    ".": "./index.mjs",
    "./lib/*": "./lib/*"
  },
  "main": "./index.mjs",
  "files": [
    "LICENSE",
    "*.mjs",
    "lib/*.mjs",
    "runtime/**",
    "docs/*.md",
    "*.ts",
    "!*.spec.mjs",
    "CHANGELOG.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "eslint-plugin-react-hooks": ">=7",
    "typescript": ">=5.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test \"*.spec.mjs\""
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "starci",
    "canon"
  ],
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "65.0.0"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3"
  }
}
