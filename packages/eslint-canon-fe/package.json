{
  "name": "@starci/eslint-canon-fe",
  "version": "9.5.2",
  "description": "Universal front-end lint laws for TypeScript and Next.js, independent of the selected Grammar family.",
  "type": "module",
  "license": "MIT",
  "author": "starci183",
  "homepage": "https://github.com/starci183/starci-harness/tree/main/packages/eslint-canon-fe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starci183/starci-harness.git",
    "directory": "packages/eslint-canon-fe"
  },
  "bugs": {
    "url": "https://github.com/starci183/starci-harness/issues"
  },
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lib/*.mjs": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./lib/*.js": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#runtime/*": {
      "types": "./src/types/runtime/*",
      "default": "./runtime/*"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "runtime/**",
    "docs/*.md",
    "CHANGELOG.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "eslint-plugin-react-hooks": ">=7",
    "typescript": ">=5.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.build.json && node -e \"const fs = require('node:fs'); for (const f of fs.readdirSync('dist', {recursive: true}).filter((n) => n.endsWith('.d.ts'))) fs.writeFileSync('dist/' + f, fs.readFileSync('dist/' + f, 'utf8').replace(/((?:from |import\\()['\\x22]\\.\\.?\\/[^'\\x22]+)\\.ts(['\\x22])/g, (all, head, quote) => head + '.js' + quote))\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"src/**/*.spec.ts\"",
    "prepack": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "starci",
    "canon"
  ],
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript-eslint/utils": "^8.72.1",
    "eslint-plugin-sonarjs": "4.2.1",
    "eslint-plugin-unicorn": "65.0.0"
  },
  "devDependencies": {
    "@starci/tsconfig": "file:../tsconfig",
    "@types/node": "^24.19.2",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3"
  }
}
