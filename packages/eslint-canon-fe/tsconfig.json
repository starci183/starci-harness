{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@starci/tsconfig/package-esm.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@starci/hfs/runtime/*": [
        "./src/types/runtime/*",
