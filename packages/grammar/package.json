{
  "name": "@starci/grammar",
  "version": "0.60.0",
  "description": "Reusable StarCi React components, compositions, and packaged visual DNA.",
  "keywords": [
    "starci",
    "design-system",
    "grammar"
  ],
  "type": "module",
  "license": "MIT",
  "author": "starci183",
  "homepage": "https://github.com/starci183/starci-harness/tree/main/packages/grammar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starci183/starci-harness.git",
    "directory": "packages/grammar"
  },
  "bugs": {
    "url": "https://github.com/starci183/starci-harness/issues"
  },
  "sideEffects": [
    "./dist/**/*.css"
  ],
  "files": [
    "dist",
    "!dist/stories",
    "!dist/**/*.stories.*",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./common": {
      "types": "./dist/common/index.d.ts",
      "import": "./dist/common/index.js"
    },
    "./common.css": "./dist/common/styles.css",
    "./common/styles.css": "./dist/common/styles.css",
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./core/ext/recharts": {
      "types": "./dist/core/ext/recharts/index.d.ts",
      "import": "./dist/core/ext/recharts/index.js"
    },
    "./core/ext/pdf": {
      "types": "./dist/core/ext/pdf/index.d.ts",
      "import": "./dist/core/ext/pdf/index.js"
    },
    "./core/ext/dropzone": {
      "types": "./dist/core/ext/dropzone/index.d.ts",
      "import": "./dist/core/ext/dropzone/index.js"
    },
    "./core/ext/chat": {
      "types": "./dist/core/ext/chat/index.d.ts",
      "import": "./dist/core/ext/chat/index.js"
    },
    "./core/ext/chat.css": "./dist/core/ext/chat/styles.css",
    "./core.css": "./dist/core/styles.css",
    "./core/styles.css": "./dist/core/styles.css",
    "./core/theme.css": "./dist/core/theme.css",
    "./core/ext/graph": {
      "types": "./dist/core/ext/graph/index.d.ts",
      "import": "./dist/core/ext/graph/index.js"
    },
    "./core/ext/graph.css": "./dist/core/ext/graph/styles.css",
    "./core/ext/markdown": {
      "types": "./dist/core/ext/markdown/index.d.ts",
      "import": "./dist/core/ext/markdown/index.js"
    },
    "./core/ext/markdown/react": {
      "types": "./dist/core/ext/markdown/react/index.d.ts",
      "import": "./dist/core/ext/markdown/react/index.js"
    },
    "./core/ext/markdown/server": {
      "types": "./dist/core/ext/markdown/server/index.d.ts",
      "import": "./dist/core/ext/markdown/server/index.js"
    },
    "./core/ext/markdown/prerender": {
      "types": "./dist/core/ext/markdown/prerender/index.d.ts",
      "import": "./dist/core/ext/markdown/prerender/index.js"
    },
    "./core/ext/markdown.css": "./dist/core/ext/markdown/styles.css",
    "./theme-hooks.json": "./dist/common/theme-hooks.json",
    "./offset-pop": {
      "types": "./dist/offset-pop/index.d.ts",
      "import": "./dist/offset-pop/index.js"
    },
    "./offset-pop.css": "./dist/offset-pop/styles.css",
    "./offset-pop/styles.css": "./dist/offset-pop/styles.css",
    "./offset-pop/theme.css": "./dist/offset-pop/theme.css",
    "./codemods": {
      "types": "./dist/codemods/index.d.mts",
      "import": "./dist/codemods/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean.mts && tsc -p tsconfig.build.json && tsc -p tsconfig.codemods.json && node scripts/copy-css.mts && node scripts/build-stamp.mts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.stories.json && tsc -p tsconfig.scripts.json && tsc -p tsconfig.codemods-spec.json && tsc -p tsconfig.specs.json && tsc -p tsconfig.ext-demo.json",
    "prove-theme": "node scripts/prove-theme.mts",
    "audit:gap": "node scripts/audit-gap.mts",
    "check:loading": "node scripts/check-region-loading.mts",
    "check:client": "node scripts/check-client-boundary.mts",
    "check:tones": "node scripts/check-tone-tokens.mts",
    "check:type": "node scripts/check-type-roles.mts",
    "check:hooks": "node scripts/check-theme-hooks.mts",
    "check:libraries": "node scripts/check-libraries.mts",
    "test:codemods": "node --test \"codemods/**/*.spec.mts\"",
    "test:specs": "node --import ./specs/support/register.mts --test \"specs/*.spec.mts\"",
    "test": "npm run typecheck && npm run check:loading && npm run check:client && npm run check:tones && npm run check:type && npm run check:hooks && npm run check:libraries && npm run test:codemods && npm run test:specs && npm run lint && npm run build",
    "pack:check": "npm run build && npm pack --dry-run",
    "prepack": "npm run typecheck && npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint --flag unstable_native_nodejs_ts_config . && stylelint \"src/**/*.css\"",
    "prove-plays": "node scripts/run-plays.mts",
    "prove-render": "playwright test",
    "prove-render:accept": "playwright test --update-snapshots --grep-invert @approved",
    "prove-render:approve": "playwright test --update-snapshots --grep @approved",
    "ext:demo": "vite ext-demo/graph",
    "ext:e2e": "playwright test -c ext-demo/graph/playwright.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dicebear/core": "10.4.0",
    "@dicebear/styles": "10.4.0",
    "dashjs": "5.3.0",
    "hls.js": "1.7.4",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mermaid": "11.16.0",
    "micromark-extension-gfm": "3.0.0"
  },
  "peerDependencies": {
    "@assistant-ui/react": "0.15.38",
    "@heroui/react": ">=3.2.0",
    "@xyflow/react": "^12.11.6",
    "beautiful-mermaid": "^1.1.3",
    "d3-force": "^3.0.0",
    "elkjs": "^0.12.0",
    "mdast-util-directive": "^3.2.0",
    "pdfjs-dist": "6.5.438",
    "react": ">=18",
    "react-aria-components": "^1.21.1",
    "react-dropzone": "15.0.0",
    "recharts": "^3.8.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.6.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@assistant-ui/react": "0.15.38",
