{
  "name": "@starci/grammar",
  "version": "0.37.36",
  "description": "Reusable StarCi React components, compositions, and packaged visual DNA.",
  "keywords": [
    "starci",
    "design-system",
    "grammar"
  ],
  "type": "module",
  "license": "MIT",
  "author": "starci183",
  "homepage": "https://github.com/starci183/starci-harness/tree/main/packages/grammar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starci183/starci-harness.git",
    "directory": "packages/grammar"
  },
  "bugs": {
    "url": "https://github.com/starci183/starci-harness/issues"
  },
  "sideEffects": [
    "./dist/**/*.css"
  ],
  "files": [
    "dist",
    "!dist/stories",
    "!dist/**/*.stories.*",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./common": {
      "types": "./dist/common/index.d.ts",
      "import": "./dist/common/index.js"
    },
    "./common.css": "./dist/common/styles.css",
    "./common/styles.css": "./dist/common/styles.css",
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./core.css": "./dist/core/styles.css",
    "./core/styles.css": "./dist/core/styles.css",
    "./core/theme.css": "./dist/core/theme.css",
    "./offset-pop": {
      "types": "./dist/offset-pop/index.d.ts",
      "import": "./dist/offset-pop/index.js"
    },
    "./offset-pop.css": "./dist/offset-pop/styles.css",
    "./offset-pop/styles.css": "./dist/offset-pop/styles.css",
    "./offset-pop/theme.css": "./dist/offset-pop/theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean.mts && tsc -p tsconfig.build.json && node scripts/copy-css.mts && node scripts/build-stamp.mts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.stories.json && tsc -p tsconfig.scripts.json",
    "prove-theme": "node scripts/prove-theme.mts",
    "audit:gap": "node scripts/audit-gap.mts",
    "check:loading": "node scripts/check-region-loading.mts",
    "check:client": "node scripts/check-client-boundary.mts",
    "check:tones": "node scripts/check-tone-tokens.mts",
    "check:type": "node scripts/check-type-roles.mts",
    "check:avatar": "node scripts/check-avatar-mark.mts",
    "test": "npm run typecheck && npm run check:loading && npm run check:client && npm run check:tones && npm run check:type && npm run check:avatar && npm run lint && npm run build",
    "pack:check": "npm run build && npm pack --dry-run",
    "prepack": "npm run typecheck && npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint --flag unstable_native_nodejs_ts_config . && stylelint \"src/**/*.css\"",
    "prove-render": "playwright test",
    "prove-render:accept": "playwright test --update-snapshots --grep-invert @approved",
    "prove-render:approve": "playwright test --update-snapshots --grep @approved"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dicebear/core": "10.4.0",
    "@dicebear/styles": "10.4.0",
    "@heroicons/react": "2.2.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mermaid": "11.16.0",
    "micromark-extension-gfm": "3.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "@heroui/react": ">=3.2.0",
    "@xyflow/react": "^12.11.6",
    "react-aria-components": "^1.21.1"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.0.0",
    "storybook": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "eslint-plugin-storybook": "^10.6.0",
    "react-dom": "^19.0.0",
    "@internationalized/date": "^3.12.4",
    "vite": "^8.3.0",
    "@types/node": "^22.0.0",
    "@xyflow/react": "12.11.6",
    "@starci/tsconfig": "2.0.7",
    "aria-query": "5.3.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "stylelint": "17.15.0",
    "postcss-value-parser": "4.2.0",
    "typescript-eslint": "8.72.0",
    "@playwright/test": "1.63.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
