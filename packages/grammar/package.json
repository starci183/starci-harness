    "@playwright/test": "1.63.0",
    "@starci/tsconfig": "2.0.7",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/d3-force": "3.0.10",
    "@types/jsdom": "21.1.7",
    "@types/mdast": "4.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@xyflow/react": "12.11.6",
    "aria-query": "5.3.0",
    "beautiful-mermaid": "1.1.3",
    "d3-force": "3.0.0",
    "elkjs": "0.12.0",
    "eslint": "10.13.0",
    "eslint-plugin-storybook": "^10.6.0",
    "jsdom": "26.1.0",
    "mdast-util-directive": "3.2.0",
    "pdfjs-dist": "6.5.438",
    "postcss-value-parser": "4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "15.0.0",
    "recharts": "3.8.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "shiki": "4.6.0",
    "storybook": "^10.6.0",
    "stylelint": "17.15.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "8.72.0",
    "unified": "11.0.5",
    "vite": "^8.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
