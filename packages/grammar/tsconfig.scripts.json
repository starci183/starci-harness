{
  "extends": "@starci/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": [
    "playwright.config.ts",
    "proof/*.ts",
    "scripts/*.mts",
    "scripts/lint/*.mts",
    "eslint.config.ts",
    "stylelint.config.ts"
  ]
}
