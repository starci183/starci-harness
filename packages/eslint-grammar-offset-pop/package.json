{
  "name": "@starci/eslint-grammar-offset-pop",
  "version": "0.15.31",
  "description": "Offset Pop Grammar lint: the inherited Common component contract over its own visual family.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "starci",
    "grammar",
    "offset-pop"
  ],
  "type": "module",
  "license": "MIT",
  "author": "starci183",
  "homepage": "https://github.com/starci183/starci-harness/tree/main/packages/eslint-grammar-offset-pop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starci183/starci-harness.git",
    "directory": "packages/eslint-grammar-offset-pop"
  },
  "bugs": {
    "url": "https://github.com/starci183/starci-harness/issues"
  },
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "runtime/**",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "typescript": ">=5.9",
    "@starci/eslint-grammar-core": "0.15.31"
  },
  "devDependencies": {
    "@starci/eslint-canon-fe": "file:../eslint-canon-fe",
    "@starci/eslint-grammar-core": "file:../eslint-grammar-core",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "@starci/tsconfig": "file:../tsconfig",
    "@types/node": "24.19.2"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.build.json && node -e \"const fs = require('node:fs'); for (const f of fs.readdirSync('dist', {recursive: true}).filter((n) => n.endsWith('.d.ts'))) fs.writeFileSync('dist/' + f, fs.readFileSync('dist/' + f, 'utf8').replace(/((?:from |import\\()['\\x22]\\.\\.?\\/[^'\\x22]+)\\.ts(['\\x22])/g, (all, head, quote) => head + '.js' + quote))\"",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run typecheck && node --test \"src/**/*.spec.ts\""
  },
  "publishConfig": {
    "access": "public"
  }
}
