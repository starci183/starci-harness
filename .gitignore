node_modules/
dist/
*.tsbuildinfo
.runtime/
# Secrets stay on the machine: secret.env at the root (and any env file) is never tracked; secret.env.example names its keys
# (policy/security.yaml says who may read them).
*.env
.env
.env.*
!*.env.example
.claude/worktrees/
cli/ops/
cli/policy/
cli/contexts/
cli/packages/
cli/skills/
cli/cli/
cli/CONTRIBUTING.md
cli/LICENSE
*.tgz
# The managed-VPS inventory (ops/vps.yaml `inventory`): a server's host, port, user and sealed keys never enter this PUBLIC
# repository, sealed or not; only the placeholder example.yaml is tracked. The secret scan refuses a tracked server file too.
ops/vps/servers/*.yaml
!ops/vps/servers/example.yaml
ops/vps/cloudflare.enc.yaml
