# The keys of the host's secret.env: copy this file to secret.env beside it (gitignored, never committed) and fill the values.
# The CLI reads a key that policy/security.yaml secretKeys lists from the process environment first, else from secret.env;
# every other key is read by the tool or stack that names it. Values are KEY=VALUE, optionally quoted; # starts a comment.

# SonarCloud token for the analyses of this repository: sonarcloud.io > My Account > Security > Generate Tokens.
SONAR_TOKEN=

# The age identity (AGE-SECRET-KEY-1...) that opens an app's .starcistacks/<env>/secrets/*.enc: the owner's existing
# identity, or a new one from `age-keygen`. `starci app secret` reads it when neither the environment nor the app's own
# .claude/secret.env selects one, and hands it to the sops child alone.
SOPS_AGE_KEY=

# Password of the self-hosted SonarQube stack's Postgres database: a long random value chosen once (openssl rand -base64 32).
SONARQUBE_DB_PASSWORD=

# Password of the self-hosted SonarQube admin user: chosen once, set at the server's first login.
SONARQUBE_ADMIN_PASSWORD=

# Connector token of the Cloudflare Tunnel that publishes the SonarQube stack: Cloudflare Zero Trust > Networks > Tunnels > the tunnel > Install connector.
CLOUDFLARE_TUNNEL_TOKEN=

# Admin user token of the self-hosted SonarQube: the server's My Account > Security > Generate Tokens, signed in as admin.
SONARQUBE_ADMIN_TOKEN=

# ElevenLabs API key for text to speech: elevenlabs.io > Profile > API Keys.
ELEVENLABS_API_KEY=

# The owner's Telegram bot (ops/telegram.yaml): message @BotFather on Telegram, send /newbot, pick a name and a username
# ending in "bot", and paste the token it answers. Then message the bot once and run `starci connect telegram discover-chat`.
TELEGRAM_BOT_TOKEN=

# Provider keys shared by apps: set once here, then `starci app secret set <env> <member> <KEY> --from-host <KEY>` seals the
# value into each app's custody without printing it. A new provider key is one entry here and one line in secretKeys.

# OpenRouter API key for the apps' language models: openrouter.ai > Keys > Create Key.
OPENROUTER_API_KEY=
